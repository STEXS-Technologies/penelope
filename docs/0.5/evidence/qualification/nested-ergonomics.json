  "criteria": [
    {
      "id": "9.2.1",
      "requirement": "State hierarchy is expressed with Rust types/traits; user authors each state and event **once**.",
      "assessment": "OrderState/Open own the nested state data once and OrderEvent owns event variants once. Node is a separate typed identity key, with explicit leaf/parent mapping; no claim of eliminating that mapping boilerplate.",
      "status": "supported_in_stated_scope_final_qualification_open"
    },
    {
      "id": "9.2.2",
      "requirement": "No repeating state names in several string transition tables.",
      "assessment": "The model uses Rust matches and typed Node keys, with no string transition tables or reflection registry.",
      "status": "supported_in_stated_scope_final_qualification_open"
    },
    {
      "id": "9.2.3",
      "requirement": "Parent fallback and leaf override are explicit and predictable.",
      "assessment": "Draft bubbles through Open to the root cancellation policy. Paid and Cancelled explicitly reject it. Removing the paid refusal lets root cancellation run and is caught by the checker.",
      "status": "supported_in_stated_scope_final_qualification_open"
    },
    {
      "id": "9.2.4",
      "requirement": "Exit/entry order is asserted by runnable tests, including self-transitions, parent transitions, and guarded failures.",
      "assessment": "One checked-in golden verifies all six complete public traces, including ordered hooks, both guards without hooks/state changes, external self-reentry and parent cancellation. Stable/MSRV local runs pass and CI/release are wired to the same checker; remote execution of this new wiring remains pending.",
      "status": "supported_in_stated_scope_final_qualification_open"
    },
    {
      "id": "9.2.5",
      "requirement": "State-local data cannot appear on the wrong enum variant.",
      "assessment": "Receipt data exists only in OrderState::Paid; enum layout enforces that structural distinction. Runtime domain validity remains a separate model check.",
      "status": "supported_in_stated_scope_final_qualification_open"
    },
    {
      "id": "9.2.6",
      "requirement": "Runtime restoration validates that the active nested path is structurally legal.",
      "assessment": "MemoryMachine::restore calls model validation; Hierarchical validation constructs the bounded StatePath before application validation. Existing malformed/depth/path tests pass in9084239 CI, not inferred from console output.",
      "status": "supported_in_stated_scope_final_qualification_open"
    },
    {
      "id": "9.2.7",
      "requirement": "The API can be used with an unboxed, allocation-free nested enum where application state permits.",
      "assessment": "The existing allocator probe now owns an inline, non-Clone Connection::{Disconnected,Connected::{Idle,Active{messages}}}. Both compilers observe zero allocation/reallocation/deallocation/requested bytes across10000 flat and10000 hierarchical attempts, with independent expected state per step and the existing positive allocator control retained.",
      "status": "supported_in_stated_scope_final_qualification_open"
    },
    {
      "id": "9.2.8",
      "requirement": "It is possible to inspect a rejected transition with its source leaf, attempted event, and guard code.",
      "assessment": "The golden contains source state, attempted event and stable guard code for both refusals. Inspection is local; rejected events do not acquire an accepted journal record.",
      "status": "supported_in_stated_scope_final_qualification_open"
    }
