  "scope": [
    "One machine with8byte state/event/intent payloads, one committed intent per event, fixed fixture policy allowing trusted local requests; not policy engine performance.",
    "Independent authorized SQLite worker/connection per writer, one committed CAS and writers-1 checked stale refusals per race. Exact retries and coherent snapshot reads measured separately.",
    "Raw per-call latency for each winner/retry/snapshot, and per-race slowest-stale/last-finish distributions; every refusal checked, only the slowest losing latency per race is retained.",
    "Eight warmups plus101 measured races per release profile; all109 event and intent rows verified, exact state/revision and retained payloads checked, integrity_check=ok.",
    "Three pinned Rust1.100 runs and one pinned Rust1.89 compatibility run. All four writer counts also exercised by three-round debug smokes on both compilers.",
    "No production source or legacy durable_store benchmark changes. Shared test preparation reused through batch_id; same async driver, policy, model and canonical codec as existing integration fixtures."
  ],
  "measurement_conditions": {
    "cpus": [
      4,
      5,
      6,
      7
    ],
    "filesystem": "Same Btrfs on local NVMe; exact findmnt metadata retained; WAL/FULL and production limits unchanged.",
    "compilers": "Both compiler wrappers empty. Same current Cargo.lock and patched SQLite3.54.1. Builds restricted to CPUs4-7.",
    "concurrent_work": "Full chaos campaign on disjoint physical cores8-15. Shared-host frequency, caches, thermals, I/O and unrelated applications uncontrolled.",
    "io": "Raw Linux process I/O counters between completed open/bootstrap and final profile verification; includes warmup, measured calls and correctness checks, not per-operation physical disk writes. WAL bytes are logical file lengths.",
    "snapshot": "Each commit retains required next-state bytes. Optional head-snapshot reads timed separately; no alternative snapshot cadence measured.",
    "throughput": "One successful commit per race; barrier release to last completed call excludes client startup/join and batch preparation. Attempts/s separately includes stale refusals. Integer rates round down.",
    "rss": "Whole benchmark process including all client/database-worker threads and four profiles; no per-profile memory or allocation count claim."
  },
  "assessment": "All current source profiles pass correctness checks. Winning commits stay around1ms, while32-writer multicore losing calls can take hundreds of milliseconds or over1s in retained runs. The implementation obtains a serialized writer transaction before checking duplicates or stale heads; this is consistent with the measured refusal tail, without a profiler-based causal attribution. This is a new hot-instance capacity finding, not an accepted regression budget or release-wide performance conclusion. No busy timeout or correctness check was relaxed. Legacy encoding/SQLite/timeline review findings, timeline-over-machine/native end-to-end metrics, full chaos and exact-candidate qualification remain open.",
  "pilot_scope": "Retain initial three single-core and three multicore runs from the pre-debug-mode fixture. Their source snapshot and runner snapshot are archived; they are exploratory, not substituted for the completed final-source full-release qualification.",
